<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build only. The instrumented tests play GitHub from a small server on the phone itself, in plain HTTP.
  The released app has no such exception: Android refuses anything but HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
