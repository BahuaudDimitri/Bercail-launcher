<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The apps that can play answer the buttons of a headset: that is how Bercail finds them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application>
        <!-- Android only tells what the media apps play to an app the user gave "notification access" to, and
             that access needs a listener to exist. This one reads nothing: it asks to be disconnected at once. -->
        <service
            android:name=".MediaListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
